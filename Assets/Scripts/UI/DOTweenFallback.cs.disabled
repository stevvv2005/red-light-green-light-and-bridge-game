using System;
using TMPro;
using UnityEngine;
using UnityEngine.UI;

namespace DG.Tweening
{
    public enum Ease { Linear, OutQuad, InQuad, OutCubic, OutBack, OutSine, InOutSine }
    public enum LoopType { Restart, Yoyo }

    public class Tween
    {
        public virtual Tween SetEase(Ease ease) { return this; }
        public virtual Tween SetLoops(int loops, LoopType loopType) { return this; }
        public virtual Tween OnComplete(Action callback) { callback?.Invoke(); return this; }
    }

    public sealed class Tweener : Tween { }

    public sealed class Sequence : Tween
    {
        public Sequence Append(Tween tween) { return this; }
        public Sequence Join(Tween tween) { return this; }
        public Sequence Insert(float atPosition, Tween tween) { return this; }
        public void Kill() { }
        public override Tween SetLoops(int loops, LoopType loopType) { return this; }
        public override Tween OnComplete(Action callback) { callback?.Invoke(); return this; }
    }

    public static class DOTween
    {
        public static Sequence Sequence() { return new Sequence(); }
    }

    public static class DOTweenFallbackExtensions
    {
        public static Tweener DOAnchorPos(this RectTransform target, Vector2 endValue, float duration)
        {
            if (target != null)
                target.anchoredPosition = endValue;
            return new Tweener();
        }

        public static Tweener DOShakeAnchorPos(this RectTransform target, float duration, Vector2 strength, int vibrato, float randomness, bool snapping, bool fadeOut)
        {
            return new Tweener();
        }

        public static Tweener DOShakeAnchorPos(this RectTransform target, float duration, float strength, int vibrato, float randomness, bool snapping, bool fadeOut)
        {
            return new Tweener();
        }

        public static Tweener DOScale(this Transform target, float endValue, float duration)
        {
            if (target != null)
                target.localScale = Vector3.one * endValue;
            return new Tweener();
        }

        public static Tweener DOScale(this Transform target, Vector3 endValue, float duration)
        {
            if (target != null)
                target.localScale = endValue;
            return new Tweener();
        }

        public static Tweener DOScaleY(this Transform target, float endValue, float duration)
        {
            if (target != null)
            {
                Vector3 scale = target.localScale;
                scale.y = endValue;
                target.localScale = scale;
            }
            return new Tweener();
        }

        public static Tweener DOPunchScale(this Transform target, Vector3 punch, float duration, int vibrato, float elasticity)
        {
            return new Tweener();
        }

        public static Tweener DOColor(this TMP_Text target, Color endValue, float duration)
        {
            if (target != null)
                target.color = endValue;
            return new Tweener();
        }

        public static Tweener DOFade(this Image target, float endValue, float duration)
        {
            if (target != null)
            {
                Color color = target.color;
                color.a = endValue;
                target.color = color;
            }
            return new Tweener();
        }

        public static Tweener DOFade(this CanvasGroup target, float endValue, float duration)
        {
            if (target != null)
                target.alpha = endValue;
            return new Tweener();
        }

        public static Tweener DOFillAmount(this Image target, float endValue, float duration)
        {
            if (target != null)
                target.fillAmount = endValue;
            return new Tweener();
        }
    }
}

